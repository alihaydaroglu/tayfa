#!/usr/bin/env python3
"""Show all open items addressed to an agent across coordination files.

Usage:
    tayfa-inbox <tag>                          # auto-discover coord dir
    tayfa-inbox @<tag>                         # @ is optional
    tayfa-inbox --coord-dir <path> <tag>       # explicit coord dir

Discovery: walks up from the current working directory looking for
`dev/coordination/AGENTS.md`. The directory containing AGENTS.md is the
coord dir.

Scans every `*.md` in the coord dir (except README.md, AGENTS.md,
ONBOARDING.md) for:
  - Open tasks: unchecked "[ ]" items inside "### Tasks — @<tag>" sections
  - Open bugs:  unchecked "[ ]" items inside "### Bugs  — @<tag>" sections
  - Memos: "### ..." sections containing "**To:** ... @<tag>" where the
    header is not struck through (~~) and the tag has not been flipped
    to # in the To: line.

Broadcast: `@all` addresses every agent. A "**To:** @all" memo (or a
"### Tasks — @all" section) lands in every inbox. To acknowledge an
@all memo without hiding it from others, append your own `#<tag>` to
its To: line — the memo stops showing for you once `#<your tag>`
appears there, and is struck `~~` only when everyone relevant has.
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path


SKIP_FILES = {"README.md", "AGENTS.md", "ONBOARDING.md"}


# ── Tag aliases ─────────────────────────────────────────────────────────
#
# A project may map short tags to canonical ones in
# `dev/coordination/aliases.json` ({"kfe": "keyframe_editor"}; keys that
# start with "_" are comments). One agent, several names: the alias is
# accepted wherever a tag is, and resolves to the canonical tag BEFORE any
# file is touched, so presence, beats, pings and scratchboards all live
# under the canonical name.

def load_aliases(coord_dir: Path) -> dict[str, str]:
    """{alias: canonical}. Missing or unparseable file = no aliases."""
    try:
        data = json.loads((coord_dir / "aliases.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    return {str(k).lstrip("@"): str(v).lstrip("@")
            for k, v in data.items()
            if isinstance(v, str) and not str(k).startswith("_")}


def canonical_tag(coord_dir: Path, tag: str) -> str:
    return load_aliases(coord_dir).get(tag, tag)


def tag_names(coord_dir: Path, tag: str) -> list[str]:
    """The canonical tag first, then every alias of it."""
    aliases = load_aliases(coord_dir)
    canon = aliases.get(tag, tag)
    return [canon] + sorted(a for a, c in aliases.items() if c == canon)


def find_coord_dir(start: Path) -> Path | None:
    """Walk up from `start` looking for `dev/coordination/AGENTS.md`."""
    cur = start.resolve()
    while True:
        candidate = cur / "dev" / "coordination" / "AGENTS.md"
        if candidate.is_file():
            return candidate.parent
        if cur.parent == cur:
            return None
        cur = cur.parent


# ── Dormant-board filtering ─────────────────────────────────────────────
#
# Boards are append-only and memos are only struck (`~~`) once EVERY
# addressed agent flips to `#`. In practice nobody flips, so a long-lived
# tag accumulates every memo it was ever cc'd on: measured 2026-09-02 on
# nima, @pm's inbox was 1,082 memos / 16k words — 22k tokens of two-month-
# old headers read at the top of every fresh context.
#
# A board that has not been committed to in `--stale-days` is dormant: its
# memos are history, not work. They are counted and named in a footer, never
# silently dropped, and `--all` brings them back.

DEFAULT_STALE_DAYS = 14
DEFAULT_LIMIT = 40


# ── Project switches (tayfa.json) ───────────────────────────────────────
#
# `dev/coordination/tayfa.json` holds per-project defaults for the tayfa
# tools. Missing file, bad JSON or a missing key = the tool's own default.
# Every switch here is reversible by deleting one key.

def load_tayfa_config(coord_dir: Path) -> dict:
    try:
        data = json.loads((coord_dir / "tayfa.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


# ── Memo age ────────────────────────────────────────────────────────────
#
# The acknowledgement ritual (`@` -> `#`, then `~~`) is not followed:
# measured 2026-10-20 on nima, 1,085 memos opened in 30 days, 4 struck.
# So a memo's AGE is the only signal that it is history. Memo headers
# carry their date by convention ("### 📐 2026-08-14 — @pm → ..."); a memo
# dated more than `memo_stale_days` ago (tayfa.json, default 21; 0 = off)
# drops to the HISTORY footer. Undated memos keep the board-age rule only.
# Tasks and bugs are never filtered by age.

DEFAULT_MEMO_DAYS = 21
_HEADER_DATE = re.compile(r"(20\d\d)-(\d\d)-(\d\d)")


def memo_age_days(header: str) -> float | None:
    """Days since the date written in a memo header, or None when it has none."""
    import datetime as _dt
    m = _HEADER_DATE.search(header[:80])
    if not m:
        return None
    try:
        d = _dt.date(int(m.group(1)), int(m.group(2)), int(m.group(3)))
    except ValueError:
        return None
    return (_dt.date.today() - d).days


def board_ages(coord_dir: Path, files: list[Path]) -> dict[str, float]:
    """{filename: fractional days since it last changed}. Falls back to mtime, then to 0.

    Fails OPEN: any file we cannot date is treated as fresh (age 0) so a
    broken git or a brand-new untracked board never hides real work.
    """
    import subprocess
    import time

    ages: dict[str, float] = {}
    now = time.time()
    try:
        out = subprocess.run(
            ["git", "-C", str(coord_dir), "log", "--format=%ct", "--name-only", "--", "."],
            capture_output=True, text=True, timeout=20, check=True,
        ).stdout
        stamp = None
        prefix = None
        for line in out.splitlines():
            line = line.strip()
            if not line:
                continue
            if line.isdigit() and len(line) >= 9:
                stamp = int(line)
                continue
            if stamp is None:
                continue
            name = Path(line).name
            if prefix is None:
                prefix = line[: len(line) - len(name)]
            # first (newest) commit touching this path wins
            ages.setdefault(name, (now - stamp) / 86400.0)
    except Exception:
        pass

    # A file edited on disk is fresh no matter when it was last committed:
    # take the YOUNGER of (last commit, mtime). Without this, a brand-new
    # memo appended to a dormant board is invisible until someone commits it.
    for f in files:
        try:
            mtime_age = (now - f.stat().st_mtime) / 86400.0
        except OSError:
            mtime_age = 0.0
        ages[f.name] = min(ages.get(f.name, mtime_age), mtime_age)
    return ages

def iter_sections(lines: list[str]):
    """Yield (header_text, section_body_lines, header_line_no) for each ### section."""
    header_re = re.compile(r"^### (.+)")
    current_header = None
    current_start = 0
    current_body: list[tuple[int, str]] = []

    for i, line in enumerate(lines, start=1):
        m = header_re.match(line)
        if m:
            if current_header is not None:
                yield current_header, current_body, current_start
            current_header = m.group(1)
            current_start = i
            current_body = []
        elif line.startswith("## ") and current_header is not None:
            yield current_header, current_body, current_start
            current_header = None
            current_body = []
        else:
            if current_header is not None:
                current_body.append((i, line))

    if current_header is not None:
        yield current_header, current_body, current_start


def _mention(sigil: str, names: list[str]) -> re.Pattern:
    """`@name` / `#name` as a whole tag — `@kfe` must not match `@kfe_polish`
    (an alias is usually a PREFIX of other tags, so a bare substring test
    would hand an alias its neighbours' mail)."""
    alt = "|".join(re.escape(n) for n in names)
    return re.compile(rf"{re.escape(sigil)}(?:{alt})(?![A-Za-z0-9_])")


def find_open_items(tag: str | list[str], files: list[Path]) -> dict[str, list[tuple[Path, int, str]]]:
    """Return {category: [(file, line_no, text), ...]}.

    `tag` may be a list: the canonical tag plus its aliases, all of which
    address the same agent."""
    names = [tag] if isinstance(tag, str) else list(tag)
    at_re = _mention("@", names)
    hash_re = _mention("#", names)
    task_hdr = re.compile(rf"^Tasks — (?:@all|{at_re.pattern})")
    bug_hdr = re.compile(rf"^Bugs — (?:@all|{at_re.pattern})")

    open_tasks: list[tuple[Path, int, str]] = []
    open_bugs: list[tuple[Path, int, str]] = []
    memos: list[tuple[Path, int, str]] = []

    unchecked = re.compile(r"^\s*(?:\d+\.|[-*])\s*\[\s\]\s*(.+)")

    for f in files:
        if not f.exists():
            continue
        lines = f.read_text(encoding="utf-8").splitlines()

        for header, body, header_line in iter_sections(lines):
            is_task_section = bool(task_hdr.match(header))
            is_bug_section = bool(bug_hdr.match(header))
            bucket = (
                open_tasks if is_task_section
                else open_bugs if is_bug_section
                else None
            )
            if bucket is not None:
                for line_no, line in body:
                    m = unchecked.match(line)
                    if m:
                        bucket.append((f, line_no, m.group(1).strip()))
                continue

            if "~~" in header:
                continue
            addressed = False
            acknowledged = False
            for _line_no, line in body:
                if line.startswith("**To:**"):
                    if at_re.search(line) or "@all" in line:
                        addressed = True
                    if hash_re.search(line):
                        acknowledged = True
            if addressed and not acknowledged:
                memos.append((f, header_line, header))

    return {"tasks": open_tasks, "bugs": open_bugs, "memos": memos}


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Show open items addressed to an agent across coordination files.",
    )
    parser.add_argument("tag", help="Agent tag (with or without leading @)")
    parser.add_argument(
        "--coord-dir",
        type=Path,
        default=None,
        help="Path to the coordination directory (default: walk up from cwd looking for dev/coordination/AGENTS.md)",
    )
    parser.add_argument(
        "--stale-days",
        type=int,
        default=DEFAULT_STALE_DAYS,
        metavar="N",
        help=f"Hide memos on boards with no commit in N days (default: {DEFAULT_STALE_DAYS}). 0 disables.",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=DEFAULT_LIMIT,
        metavar="N",
        help=f"Max items shown per section (default: {DEFAULT_LIMIT}). 0 for no limit.",
    )
    parser.add_argument("--memo-days", type=int, default=None, metavar="N",
                        help=f"Hide memos whose header date is older than N days "
                             f"(default: tayfa.json memo_stale_days, else {DEFAULT_MEMO_DAYS}). 0 disables.")
    parser.add_argument(
        "--all",
        action="store_true",
        help="Show everything: no staleness filter, no per-section limit.",
    )
    args = parser.parse_args()

    tag = args.tag.lstrip("@")

    coord_dir = args.coord_dir
    if coord_dir is None:
        coord_dir = find_coord_dir(Path.cwd())
        if coord_dir is None:
            print(
                "ERROR: could not find dev/coordination/AGENTS.md in any ancestor of cwd.\n"
                "       Pass --coord-dir <path> or cd into a tayfa-initialised project.",
                file=sys.stderr,
            )
            return 1
    elif not (coord_dir / "AGENTS.md").is_file():
        print(f"ERROR: {coord_dir} does not look like a coord dir (no AGENTS.md).", file=sys.stderr)
        return 1

    names = tag_names(coord_dir, tag)      # canonical first, then aliases
    tag = names[0]
    files = sorted(f for f in coord_dir.glob("*.md") if f.name not in SKIP_FILES)
    results = find_open_items(names, files)

    stale_days = 0 if args.all else max(0, args.stale_days)
    limit = 0 if args.all else max(0, args.limit)

    hidden_memos: list[tuple[Path, int, str]] = []
    if stale_days or limit:
        ages = board_ages(coord_dir, files)
        # Freshest board first, and within a board the LAST-appended memo
        # first (boards are append-only, so a higher line number is newer).
        # Without this the per-section cap buries brand-new memos.
        results["memos"].sort(key=lambda it: (ages.get(it[0].name, 0.0), -it[1]))
        if stale_days:
            fresh, dormant = [], []
            for item in results["memos"]:
                (dormant if ages.get(item[0].name, 0.0) >= stale_days else fresh).append(item)
            results["memos"] = fresh
            hidden_memos = dormant

    # Per-memo age (see memo_age_days). Applied after the board rule, so the
    # footer can say how many went for each reason.
    cfg = load_tayfa_config(coord_dir)
    if args.all:
        memo_days = 0
    elif args.memo_days is not None:
        memo_days = max(0, args.memo_days)
    else:
        try:
            memo_days = max(0, int(cfg.get("memo_stale_days", DEFAULT_MEMO_DAYS)))
        except (TypeError, ValueError):
            memo_days = DEFAULT_MEMO_DAYS
    aged_memos: list[tuple[Path, int, str]] = []
    if memo_days:
        live = []
        for item in results["memos"]:
            age = memo_age_days(item[2])
            (aged_memos if age is not None and age > memo_days else live).append(item)
        results["memos"] = live

    width = 60
    print("=" * width)
    also = f"  (also @{', @'.join(names[1:])})" if len(names) > 1 else ""
    print(f"  INBOX for @{tag}{also}")
    print(f"  ({coord_dir})")
    print("=" * width)
    print()

    sections = [
        ("OPEN TASKS", results["tasks"]),
        ("OPEN BUGS", results["bugs"]),
        ("MEMOS ADDRESSED TO YOU", results["memos"]),
    ]
    total = sum(len(items) for _, items in sections)

    for label, items in sections:
        print(f"── {label} ({len(items)}) ──")
        if not items:
            print("  (none)")
        else:
            shown = items[:limit] if limit else items
            for f, line_no, text in shown:
                rel = f.name
                display = text if len(text) <= 90 else text[:87] + "..."
                print(f"  {rel}:{line_no}  {display}")
            if len(items) > len(shown):
                print(
                    f"  … {len(items) - len(shown)} more not shown "
                    f"(tayfa-inbox --limit 0 {tag})"
                )
        print()

    if hidden_memos or aged_memos:
        print("── HISTORY ──")
        if hidden_memos:
            boards = sorted({f.name for f, _, _ in hidden_memos})
            head = ", ".join(boards[:6]) + (f", +{len(boards) - 6} more" if len(boards) > 6 else "")
            print(
                f"  {len(hidden_memos)} older memo(s) on {len(boards)} dormant board(s) "
                f"(no commit in {stale_days}+ days) are not listed:\n"
                f"    {head}"
            )
        if aged_memos:
            print(
                f"  {len(aged_memos)} memo(s) dated more than {memo_days} days ago are not listed "
                f"(tayfa-inbox --memo-days 0 {tag} lists them; tayfa.json memo_stale_days sets the default)."
            )
        print(f"  These are a record, not work. To see everything: tayfa-inbox --all {tag}")
        print()

    if total == 0:
        print("Inbox zero. You're clear." if not (hidden_memos or aged_memos) else "Nothing live. You're clear.")
    else:
        print(f"Total open items: {total}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
