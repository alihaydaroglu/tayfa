#!/usr/bin/env python3
"""List awake agents in the current tayfa project.

Reads `dev/coordination/.presence/*.json` (session registry, written by
register_presence.sh) and `.presence/beats/<tag>.json` (heartbeats,
written by tayfa-beat — typically from a user-level Claude Code Stop
hook, so every registered session beats at the end of every turn).

Usage:
    tayfa-roster                          # one-shot CLI roster
    tayfa-roster --coord-dir <path>
    tayfa-roster --json                   # machine-readable output
    tayfa-roster --serve [--port 8533]    # loopback web page + /roster.json

One-shot mode keeps the original behavior: entries whose PID (or tmux
session) is gone are pruned. Serve mode is strictly READ-ONLY — it never
deletes registry files — and adds beat-based status:

    AWAKE — pid alive, beat fresher than --stale-after (default 20 min)
    QUIET — pid alive, beat stale or absent (idle, or its loop/cron died)
    GONE  — pid dead; shown greyed with last-seen for 24 h, then hidden

Optional extra columns: if `.presence/roster.conf.json` exists with
    {"columns": [{"name": "last commit", "cmd": "git log ... {tag} ..."}]}
each cmd runs per tag ({tag} substituted) in the repo root, 3 s timeout.
"""
from __future__ import annotations

import argparse
import errno
import html
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

GONE_VISIBLE_SECS = 24 * 3600
DEFAULT_STALE_AFTER = 1200
DEFAULT_PORT = 8533


def find_coord_dir(start: Path) -> Path | None:
    cur = start.resolve()
    while True:
        candidate = cur / "dev" / "coordination" / "AGENTS.md"
        if candidate.is_file():
            return candidate.parent
        if cur.parent == cur:
            return None
        cur = cur.parent


def pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True  # exists, just not ours
    except OSError as e:
        return e.errno != errno.ESRCH
    return True


def tmux_target_alive(target: str) -> bool:
    if not shutil.which("tmux"):
        return True  # can't check; trust it
    session = target.split(":", 1)[0]
    return subprocess.run(
        ["tmux", "has-session", "-t", session],
        capture_output=True,
    ).returncode == 0


def load_entry(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return None


def is_alive(entry: dict) -> bool:
    pid = entry.get("pid")
    if not isinstance(pid, int) or not pid_alive(pid):
        return False
    target = entry.get("tmux_target")
    if target and not tmux_target_alive(target):
        return False
    return True


def humanize_secs(secs: int) -> str:
    if secs < 0:
        secs = 0
    if secs < 60:
        return f"{secs}s"
    mins = secs // 60
    if mins < 60:
        return f"{mins}m"
    hours, mins = divmod(mins, 60)
    if hours < 24:
        return f"{hours}h {mins}m"
    days, hours = divmod(hours, 24)
    return f"{days}d {hours}h"


def humanize_uptime(started_iso: str) -> str:
    try:
        started = datetime.fromisoformat(started_iso.replace("Z", "+00:00"))
    except ValueError:
        return "?"
    delta = datetime.now(timezone.utc) - started
    return humanize_secs(int(delta.total_seconds()))


# ── beat-aware roster (read-only; used by --serve and /roster.json) ──

def gather_rows(coord_dir: Path, stale_after: int) -> list[dict]:
    presence_dir = coord_dir / ".presence"
    beats_dir = presence_dir / "beats"
    now = time.time()

    tags: dict[str, dict] = {}
    if presence_dir.is_dir():
        for path in sorted(presence_dir.glob("*.json")):
            entry = load_entry(path)
            if entry is None:
                continue
            tag = entry.get("tag") or path.stem
            tags.setdefault(tag, {})["presence"] = entry
    if beats_dir.is_dir():
        for path in sorted(beats_dir.glob("*.json")):
            beat = load_entry(path) or {}
            try:
                beat["_mtime"] = path.stat().st_mtime
            except OSError:
                continue
            tags.setdefault(path.stem, {})["beat"] = beat

    rows: list[dict] = []
    for tag, parts in tags.items():
        presence = parts.get("presence")
        beat = parts.get("beat")
        alive = presence is not None and is_alive(presence)
        beat_age = int(now - beat["_mtime"]) if beat else None

        # A fresh beat outranks the pid: some harnesses respawn the host
        # process constantly, so a dead registered pid does NOT mean a dead
        # session — but a beat can only come from a live one.
        if beat_age is not None and beat_age <= stale_after:
            status = "AWAKE"
        elif alive:
            status = "QUIET"
        else:
            if beat_age is None or beat_age > GONE_VISIBLE_SECS:
                continue  # long gone (or no beat data at all) — drop from view
            status = "GONE"

        rows.append({
            "tag": tag,
            "status": status,
            "pid": presence.get("pid") if presence else None,
            "beat_age_s": beat_age,
            "beats": beat.get("beats") if beat else None,
            "note": beat.get("note") if beat else None,
            "uptime": humanize_uptime(presence.get("started_at", "")) if alive else None,
            "tmux_target": presence.get("tmux_target") if presence else None,
        })

    order = {"AWAKE": 0, "QUIET": 1, "GONE": 2}
    rows.sort(key=lambda r: (order[r["status"]], r["tag"]))
    return rows


def load_extra_columns(coord_dir: Path) -> list[dict]:
    conf = load_entry(coord_dir / ".presence" / "roster.conf.json")
    if not isinstance(conf, dict):
        return []
    cols = conf.get("columns")
    if not isinstance(cols, list):
        return []
    return [c for c in cols if isinstance(c, dict) and c.get("name") and c.get("cmd")]


def run_extra_column(cmd: str, tag: str, repo_root: Path) -> str:
    try:
        out = subprocess.run(
            cmd.replace("{tag}", tag),
            shell=True, capture_output=True, text=True,
            timeout=3, cwd=repo_root,
        ).stdout.strip()
        return out[:120] or "-"
    except (subprocess.TimeoutExpired, OSError):
        return "?"


# ── web server ──

STATUS_COLOR = {
    "AWAKE": "#2da44e",
    "QUIET": "#d4a72c",
    "GONE": "#8b949e",
}

# NOTE: all intra-dashboard URLs are RELATIVE so pages work both standalone
# (http://127.0.0.1:8533/) and behind a reverse-proxy prefix (e.g. a project
# portal at /s/roster/).
BASE_CSS = """
  :root { color-scheme: light dark;
    --fg: #1f2328; --bg: #ffffff; --muted: #6a737d; --line: #d8dee4; --row: #f6f8fa;
    --box: #f6f8fa; --accent: #2da44e; --ansbg: #eaf7ee; --ansline: #bce4c8; }
  @media (prefers-color-scheme: dark) {
    :root { --fg: #e6edf3; --bg: #0d1117; --muted: #8b949e; --line: #30363d; --row: #161b22;
    --box: #161b22; --accent: #238636; --ansbg: #0f2418; --ansline: #1f4d2e; } }
  body { margin: 2rem auto; max-width: 72rem; padding: 0 1rem;
    font: 14px/1.5 ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: var(--fg); background: var(--bg); }
  h1 { font-size: 1.1rem; } h1 small { color: var(--muted); font-weight: normal; }
  h2 { font-size: 1rem; margin: 1.8rem 0 .4rem; color: var(--muted); }
  .summary { color: var(--muted); margin: .3rem 0 1rem; }
  .summary a, nav a { color: inherit; }
  div.tablewrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; }
  th, td { text-align: left; padding: .45rem .8rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { color: var(--muted); font-weight: normal; }
  tr:nth-child(even) td { background: var(--row); }
  td.note { white-space: normal; max-width: 26rem; }
  .dot { display: inline-block; width: .6rem; height: .6rem; border-radius: 50%; margin-right: .45rem; }
  tr.gone td { color: var(--muted); }
  .muted { color: var(--muted); }
  footer { margin-top: 1rem; color: var(--muted); font-size: .85em; }
  a { color: inherit; }
  .card { border: 1px solid var(--line); border-radius: 8px; padding: .7rem .9rem; margin: .6rem 0; }
  .card p { margin: .2rem 0; }
  .detail, .owner { color: var(--muted); font-size: .86em; }
  pre.ctx { white-space: pre-wrap; background: var(--box); padding: .5rem .7rem;
            border-radius: 6px; font-size: .92em; margin: .5rem 0; }
  pre.ans { white-space: pre-wrap; background: var(--ansbg); border: 1px solid var(--ansline);
            padding: .5rem .7rem; border-radius: 6px; font-size: .92em; margin: .5rem 0; }
  textarea { width: 100%; box-sizing: border-box; background: var(--box); color: var(--fg);
             border: 1px solid var(--line); border-radius: 6px; padding: .5rem; font: inherit; }
  button { margin-top: .4rem; background: var(--accent); color: #fff; border: 0;
           border-radius: 6px; padding: .35rem .9rem; font: inherit; cursor: pointer; }
  code { background: var(--box); padding: .08rem .3rem; border-radius: 4px; font-size: .86em; }
  details { margin-top: 1rem; } summary { color: var(--muted); cursor: pointer; }
"""

PAGE_TEMPLATE = """<!doctype html>
<html><head>
<meta charset="utf-8">
<meta http-equiv="refresh" content="20">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tayfa roster — {project}</title>
<style>{css}</style>
</head><body>
<h1>tayfa roster <small>— {project}</small></h1>
<div class="summary">{summary} · refreshed {now} UTC · auto-refresh 20s</div>
<div class="tablewrap"><table>
<tr><th>agent</th><th>status</th><th>last beat</th><th>ticks</th><th>uptime</th><th>tmux</th><th>note</th>{extra_headers}</tr>
{rows}
</table></div>
<footer>AWAKE = beat &lt; {stale}m ago · QUIET = session alive, no recent beat (idle, or its loop/cron died — re-arm?) ·
GONE = session ended (shown 24h) · JSON: <a href="roster.json">roster.json</a></footer>
</body></html>
"""

def render_html(coord_dir: Path, stale_after: int) -> str:
    rows = gather_rows(coord_dir, stale_after)
    extra_cols = load_extra_columns(coord_dir)
    repo_root = coord_dir.parent.parent
    project = html.escape(repo_root.name)

    counts = {"AWAKE": 0, "QUIET": 0, "GONE": 0}
    body_rows = []
    for r in rows:
        counts[r["status"]] += 1
        color = STATUS_COLOR[r["status"]]
        beat_txt = humanize_secs(r["beat_age_s"]) + " ago" if r["beat_age_s"] is not None else "never"
        cells = [
            f"<td>@{html.escape(r['tag'])}</td>",
            f"<td><span class=\"dot\" style=\"background:{color}\"></span>{r['status']}</td>",
            f"<td>{beat_txt}</td>",
            f"<td>{r['beats'] if r['beats'] is not None else '-'}</td>",
            f"<td>{html.escape(r['uptime'] or '-')}</td>",
            f"<td class=\"muted\">{html.escape(r['tmux_target'] or '-')}</td>",
            f"<td class=\"note\">{html.escape(r['note'] or '')}</td>",
        ]
        for col in extra_cols:
            cells.append(f"<td class=\"muted\">{html.escape(run_extra_column(col['cmd'], r['tag'], repo_root))}</td>")
        cls = " class=\"gone\"" if r["status"] == "GONE" else ""
        body_rows.append(f"<tr{cls}>{''.join(cells)}</tr>")

    if not body_rows:
        body_rows.append(
            '<tr><td colspan="9" class="muted">No registered agents. '
            "(Sessions register via the onboarding ritual; beats come from the tayfa-beat Stop hook.)</td></tr>"
        )

    summary = f"{counts['AWAKE']} awake · {counts['QUIET']} quiet · {counts['GONE']} gone"
    extra_headers = "".join(f"<th>{html.escape(c['name'])}</th>" for c in extra_cols)
    return PAGE_TEMPLATE.format(
        css=BASE_CSS, project=project, summary=summary,
        now=datetime.now(timezone.utc).strftime("%H:%M:%S"),
        rows="\n".join(body_rows), extra_headers=extra_headers,
        stale=stale_after // 60,
    )


def serve(coord_dir: Path, bind: str, port: int, stale_after: int) -> int:
    class Handler(BaseHTTPRequestHandler):
        def _send(self, payload: bytes, ctype: str, code: int = 200) -> None:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)

        def do_GET(self):  # noqa: N802
            path = self.path.split("?", 1)[0]
            if path == "/roster.json":
                self._send(json.dumps(gather_rows(coord_dir, stale_after), indent=2).encode(),
                           "application/json")
            elif path == "/":
                self._send(render_html(coord_dir, stale_after).encode(), "text/html; charset=utf-8")
            elif path in ("/inbox", "/inbox.json"):
                # retired with tayfa-ask (2026-09-11): the usta talks to agents in chat
                self._send(b"The usta inbox is retired (2026-09-11). Agents talk to the usta in chat.\n",
                           "text/plain; charset=utf-8", 410)
            else:
                self.send_error(404)

        def log_message(self, *args):  # quiet
            pass

    server = ThreadingHTTPServer((bind, port), Handler)
    print(f"tayfa roster serving http://{bind}:{port}/  (coord: {coord_dir})")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


# ── original one-shot CLI ──

def one_shot(coord_dir: Path, as_json: bool) -> int:
    presence_dir = coord_dir / ".presence"
    if not presence_dir.is_dir():
        if as_json:
            print("[]")
        else:
            print("No agents registered. (No .presence/ directory.)")
        return 0

    awake: list[tuple[Path, dict]] = []
    pruned: list[str] = []

    import time as _time
    for path in sorted(presence_dir.glob("*.json")):
        entry = load_entry(path)
        if entry is None or not is_alive(entry):
            # Fresh beat = live session with a churned pid — keep the entry
            # (session_id resolution still works off it).
            beat_file = presence_dir / "beats" / path.name
            try:
                fresh = _time.time() - beat_file.stat().st_mtime <= DEFAULT_STALE_AFTER
            except OSError:
                fresh = False
            if entry is not None and fresh:
                awake.append((path, entry))
                continue
            try:
                path.unlink()
                pruned.append(path.stem)
            except OSError:
                pass
            continue
        awake.append((path, entry))

    if as_json:
        print(json.dumps([entry for _, entry in awake], indent=2))
        return 0

    if not awake:
        print("No awake agents.")
        if pruned:
            print(f"Pruned {len(pruned)} stale entr{'y' if len(pruned)==1 else 'ies'}: {', '.join('@'+t for t in pruned)}")
        return 0

    print(f"{'TAG':<22} {'PID':>7}  {'TTY':<14} {'TMUX':<18} {'UPTIME':>8}")
    for _, e in awake:
        tag = "@" + e.get("tag", "?")
        pid = str(e.get("pid", "?"))
        tty = (e.get("tty") or "-")[:14]
        tmux = (e.get("tmux_target") or "-")[:18]
        uptime = humanize_uptime(e.get("started_at", ""))
        print(f"{tag:<22} {pid:>7}  {tty:<14} {tmux:<18} {uptime:>8}")

    if pruned:
        print()
        print(f"Pruned {len(pruned)} stale entr{'y' if len(pruned)==1 else 'ies'}: {', '.join('@'+t for t in pruned)}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description="List awake agents in a tayfa project.",
    )
    parser.add_argument("--coord-dir", type=Path, default=None)
    parser.add_argument("--json", action="store_true", help="JSON output (one-shot)")
    parser.add_argument("--serve", action="store_true", help="serve a loopback web roster")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT)
    parser.add_argument("--bind", default="127.0.0.1",
                        help="serve bind address (keep loopback; front with a portal/proxy for LAN)")
    parser.add_argument("--stale-after", type=int, default=DEFAULT_STALE_AFTER,
                        help="seconds before a live session with no fresh beat shows QUIET (default 1200)")
    args = parser.parse_args()

    coord_dir = args.coord_dir or find_coord_dir(Path.cwd())
    if coord_dir is None:
        print(
            "ERROR: could not find dev/coordination/AGENTS.md in any ancestor of cwd.",
            file=sys.stderr,
        )
        return 1

    if args.serve:
        return serve(coord_dir, args.bind, args.port, args.stale_after)
    return one_shot(coord_dir, args.json)


if __name__ == "__main__":
    sys.exit(main())
