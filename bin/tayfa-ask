#!/usr/bin/env python3
"""The usta's inbox — agents push questions/FYIs to the human, who answers
with the same CLI. Agents then check and acknowledge the response.

"Usta" is tayfa's name for the human the crew works for. Items are
one-JSON-file-each under `dev/coordination/usta_inbox/` so concurrent
agents never clobber each other on a shared tree. (Projects that predate
the tayfa lift may have the store at `ali_inbox/` — tayfa-ask finds and
uses that automatically.)

Usage:
  ask  — a question that needs the usta's answer (ALWAYS include context;
         they read on the web, not in your memo):
      tayfa-ask ask --from backend \
          --title "full_access exempt from consent gate?" \
          --context "Shipped default gates full_access. One-tuple flip if not." \
          [--context-file notes.md] [--link /s/myspike/]

  fyi  — something for the usta to look at (REQUIRED whenever you publish
         a spike report / review page — send the link through here):
      tayfa-ask fyi --from frontend \
          --title "FEAT-11 viewing page demo" --link /s/feat07a-legal/ \
          [--context "2-line summary"]

  check — see the usta's answers to YOUR items (run it whenever you check
          your inbox). Unacked answers only; ack what you've absorbed:
      tayfa-ask check backend [--all]
      tayfa-ask ack <id>

  list — everything still waiting on the usta (any agent may look):
      tayfa-ask list

  answer / seen — resolve an item as the usta:
      tayfa-ask answer <id> --text "decision and rationale"
      tayfa-ask seen <id>
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

STORE_NAMES = ("usta_inbox", "ali_inbox")  # legacy fallback second


def find_coord_dir(start: Path) -> Path | None:
    cur = start.resolve()
    while True:
        candidate = cur / "dev" / "coordination" / "AGENTS.md"
        if candidate.is_file():
            return candidate.parent
        if cur.parent == cur:
            return None
        cur = cur.parent


def resolve_store(coord_dir: Path) -> Path:
    """Existing store wins (legacy ali_inbox/ included); else usta_inbox/."""
    for name in STORE_NAMES:
        d = coord_dir / name
        if d.is_dir():
            return d
    return coord_dir / STORE_NAMES[0]


def _now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _slug(text: str, n: int = 28) -> str:
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:n] or "item"


def _load_all(store: Path) -> list[dict]:
    items = []
    for p in sorted(store.glob("*.json")):
        try:
            items.append(json.loads(p.read_text()))
        except (json.JSONDecodeError, OSError):
            print(f"warning: unreadable item {p.name}", file=sys.stderr)
    return items


def _write(store: Path, item: dict) -> Path:
    store.mkdir(exist_ok=True)
    p = store / f"{item['id']}.json"
    p.write_text(json.dumps(item, indent=2, ensure_ascii=False) + "\n")
    return p


def cmd_create(store: Path, args: argparse.Namespace, kind: str) -> int:
    context = args.context or ""
    if args.context_file:
        context = (context + "\n\n" if context else "") + Path(args.context_file).read_text()
    if kind == "question" and not context.strip():
        print("refusing: questions need --context (or --context-file).",
              file=sys.stderr)
        return 2
    if kind == "fyi" and not args.link:
        print("refusing: fyi needs --link (that's its whole point).", file=sys.stderr)
        return 2
    frm = args.frm.lstrip("@")
    item = {
        "id": f"{frm}-{datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')}-{_slug(args.title)}",
        "from": frm,
        "kind": kind,
        "title": args.title,
        "context": context.strip(),
        "link": args.link or "",
        "created_at": _now(),
        "status": "open",          # open -> answered (question) / seen (fyi)
        "answer": "",
        "answered_at": "",
        "acked": False,            # set by the asking agent once it read the answer
    }
    p = _write(store, item)
    print(f"created {item['id']}  ({p})")
    print(f"the usta can answer it with: tayfa-ask answer {item['id']} --text \"...\"")
    print(f"check answers with: tayfa-ask check {frm}")
    return 0


def cmd_check(store: Path, args: argparse.Namespace) -> int:
    frm = args.frm.lstrip("@")
    mine = [i for i in _load_all(store) if i["from"] == frm]
    if not mine:
        print(f"no inbox items from @{frm}")
        return 0
    answered = [i for i in mine if i["status"] in ("answered", "seen") and not i.get("acked")]
    open_ = [i for i in mine if i["status"] == "open"]
    shown = mine if args.all else answered
    if not shown and not args.all:
        print(f"no NEW answers for @{frm}"
              + (f" ({len(open_)} still open with the usta)" if open_ else ""))
        return 0
    for i in shown:
        print(f"\n== {i['id']}  [{i['status'].upper()}{' /acked' if i.get('acked') else ''}]")
        print(f"   Q ({i['kind']}): {i['title']}")
        if i["status"] == "answered":
            print(f"   A ({i['answered_at']}): {i['answer']}")
        elif i["status"] == "seen":
            print(f"   seen {i['answered_at']}")
        if i.get("thread"):
            print(f"   thread: {len(i['thread'])} message(s) — view: tayfa-ask thread {i['id']} · "
                  f"reply: tayfa-ask reply {i['id']} --from {frm} --text \"...\"")
        if not i.get("acked") and i["status"] != "open":
            print(f"   ack it:  tayfa-ask ack {i['id']}")
    if open_:
        print(f"\n({len(open_)} still open with the usta: " + ", ".join(i["id"] for i in open_) + ")")
    return 0


def locked_update(path: Path, mutate) -> dict | None:
    """Read-modify-write an item file under a platform file lock."""
    if not path.exists():
        return None
    with open(path, "r+", encoding="utf-8") as f:
        if sys.platform == "win32":
            import msvcrt
            msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)
        else:
            import fcntl
            fcntl.flock(f, fcntl.LOCK_EX)
        try:
            item = json.load(f)
            mutate(item)
            f.seek(0)
            f.truncate()
            json.dump(item, f, indent=2, ensure_ascii=False)
            f.write("\n")
        finally:
            if sys.platform == "win32":
                f.seek(0)
                msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)
            else:
                fcntl.flock(f, fcntl.LOCK_UN)
    return item


def cmd_ack(store: Path, args: argparse.Namespace) -> int:
    item = locked_update(store / f"{args.id}.json", lambda i: i.update(acked=True))
    if item is None:
        print(f"no item {args.id}", file=sys.stderr)
        return 2
    print(f"acked {args.id}")
    return 0


def cmd_reply(store: Path, args: argparse.Namespace) -> int:
    """Append a message to an item's durable thread."""
    text = args.text or ""
    if args.text_file:
        text = (text + "\n\n" if text else "") + Path(args.text_file).read_text()
    if not text.strip():
        print("refusing: reply needs --text (or --text-file).", file=sys.stderr)
        return 2
    frm = args.frm.lstrip("@")
    entry = {"from": frm, "text": text.strip(), "at": _now()}
    item = locked_update(store / f"{args.id}.json",
                         lambda i: i.setdefault("thread", []).append(entry))
    if item is None:
        print(f"no item {args.id}", file=sys.stderr)
        return 2
    print(f"reply added to {args.id} (thread now {len(item.get('thread', []))} message(s))")
    return 0


def cmd_answer(store: Path, args: argparse.Namespace) -> int:
    text = args.text or ""
    if args.text_file:
        text = (text + "\n\n" if text else "") + Path(args.text_file).read_text()
    if not text.strip():
        print("refusing: answer needs --text (or --text-file).", file=sys.stderr)
        return 2

    def answer(item: dict) -> None:
        if item.get("kind") != "question":
            raise ValueError("only question items can be answered")
        item.update(status="answered", answer=text.strip(),
                    answered_at=_now(), acked=False)

    try:
        item = locked_update(store / f"{args.id}.json", answer)
    except ValueError as exc:
        print(f"refusing: {exc}", file=sys.stderr)
        return 2
    if item is None:
        print(f"no item {args.id}", file=sys.stderr)
        return 2
    print(f"answered {args.id}; @{item['from']} can read it with tayfa-ask check {item['from']}")
    return 0


def cmd_seen(store: Path, args: argparse.Namespace) -> int:
    def mark_seen(item: dict) -> None:
        if item.get("kind") != "fyi":
            raise ValueError("only FYI items can be marked seen")
        item.update(status="seen", answered_at=_now(), acked=False)

    try:
        item = locked_update(store / f"{args.id}.json", mark_seen)
    except ValueError as exc:
        print(f"refusing: {exc}", file=sys.stderr)
        return 2
    if item is None:
        print(f"no item {args.id}", file=sys.stderr)
        return 2
    print(f"marked {args.id} seen")
    return 0


def cmd_thread(store: Path, args: argparse.Namespace) -> int:
    p = store / f"{args.id}.json"
    if not p.exists():
        print(f"no item {args.id}", file=sys.stderr)
        return 2
    i = json.loads(p.read_text())
    print(f"== {i['id']}  [{i['status'].upper()}]")
    print(f"   Q ({i.get('kind')}) @{i.get('from')}: {i.get('title')}")
    if i.get("context"):
        print("   context: " + i["context"].replace("\n", "\n            "))
    if i.get("answer"):
        print(f"   A ({i.get('answered_at', '')}): {i['answer']}")
    for e in i.get("thread", []):
        who = "usta" if e.get("from") == "usta" else "@" + e.get("from", "?")
        print(f"   [{e.get('at', '')}] {who}: {e.get('text', '')}")
    if not i.get("thread"):
        print("   (no thread messages)")
    return 0


def cmd_list(store: Path, _args: argparse.Namespace) -> int:
    open_ = [i for i in _load_all(store) if i["status"] == "open"]
    if not open_:
        print("nothing waiting on the usta")
        return 0
    for i in sorted(open_, key=lambda x: x["created_at"]):
        print(f"{i['created_at']}  {i['kind']:8s} @{i['from']:12s} {i['id']}\n    {i['title']}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--coord-dir", type=Path, default=None)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for kind in ("ask", "fyi"):
        s = sub.add_parser(kind)
        s.add_argument("--from", dest="frm", required=True, help="your agent tag")
        s.add_argument("--title", required=True)
        s.add_argument("--context", default="")
        s.add_argument("--context-file", default="")
        s.add_argument("--link", default="", help="e.g. /s/<slug>/ on the project's portal")
    c = sub.add_parser("check")
    c.add_argument("frm", help="your agent tag")
    c.add_argument("--all", action="store_true")
    a = sub.add_parser("ack")
    a.add_argument("id")
    sub.add_parser("list")
    r = sub.add_parser("reply", help="add a durable message to an item's thread")
    r.add_argument("id")
    r.add_argument("--from", dest="frm", required=True, help="your agent tag")
    r.add_argument("--text", default="")
    r.add_argument("--text-file", default="")
    t = sub.add_parser("thread", help="show an item's answer + thread")
    t.add_argument("id")
    an = sub.add_parser("answer", help="answer a question as the human owner")
    an.add_argument("id")
    an.add_argument("--text", default="")
    an.add_argument("--text-file", default="")
    se = sub.add_parser("seen", help="mark an FYI seen as the human owner")
    se.add_argument("id")
    args = ap.parse_args()

    coord_dir = args.coord_dir or find_coord_dir(Path.cwd())
    if coord_dir is None:
        print("ERROR: could not find dev/coordination/AGENTS.md in any ancestor of cwd.",
              file=sys.stderr)
        return 1
    store = resolve_store(coord_dir)

    if args.cmd in ("ask", "fyi"):
        return cmd_create(store, args, "question" if args.cmd == "ask" else "fyi")
    return {"check": cmd_check, "ack": cmd_ack, "list": cmd_list,
            "reply": cmd_reply, "thread": cmd_thread,
            "answer": cmd_answer, "seen": cmd_seen}[args.cmd](store, args)


if __name__ == "__main__":
    raise SystemExit(main())
