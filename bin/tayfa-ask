#!/usr/bin/env python3
"""RETIRED 2026-09-11. The usta's inbox is gone: agents talk to the usta in
chat.

The file inbox (`dev/coordination/usta_inbox/`, served at the roster's
/inbox) did not work: in nima, 1 of the 126 questions agents filed through
it was ever answered, and the pile of 462 unread items was a distraction,
not a channel. The usta reads the chat of the session they are working in,
so that is where a question or a review link goes: say it in your reply,
and end your turn with it.

This shim stays on PATH so a session still carrying the old instructions
is told where to go instead of silently filing into a dead store. `ask`,
`fyi` and `reply` exit non-zero and write nothing; `check`, `list`, `ack`
and `thread` exit 0 so an old ritual does not error-loop.

The old implementation is in git history (`git log -- bin/tayfa-ask`).
"""
from __future__ import annotations

import sys

WRITE_CMDS = {"ask", "fyi", "reply"}

REDIRECT = (
    "tayfa-ask is RETIRED (2026-09-11, the usta's call). Nothing reads that inbox.\n"
    "Put the question or the review link in your chat reply to the usta, in your\n"
    "own session, and end your turn with it. Nothing was written."
)
NOOP = "tayfa-ask is retired (2026-09-11): the usta answers in chat, not here. Nothing to check."


def main(argv: list[str]) -> int:
    cmd = next((a for a in argv if not a.startswith("-")), "")
    if cmd in WRITE_CMDS:
        print(REDIRECT, file=sys.stderr)
        return 3
    print(NOOP)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
