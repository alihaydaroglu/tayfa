#!/usr/bin/env python3
"""tayfa-compact — PreCompact/PostCompact hook target: make context
compaction survivable for tayfa agents.

Installed as user-level Claude Code hooks:

    "PostCompact":       [{"hooks": [{"type": "command",
                          "command": "/path/to/tayfa-compact --post",   "timeout": 10}]}]
    "UserPromptSubmit":  [{"hooks": [{"type": "command",
                          "command": "/path/to/tayfa-compact --prompt", "timeout": 10}]}]

SCHEMA NOTE (learned the hard way, 2026-07-10): PreCompact/PostCompact
hooks may NOT return hookSpecificOutput.additionalContext — the harness
rejects it. Only UserPromptSubmit (and PostToolUse/Stop) can inject
context. So the ritual is delivered as a two-step relay:

--post    (PostCompact) writes a per-session marker file under
          .presence/ritual_pending/ — no stdout at all.
--prompt  (UserPromptSubmit) checks for this session's marker; if
          present, emits schema-valid additionalContext with the
          re-entry ritual (read scratchboards/<tag>/inflight.md, re-arm
          crons — they die on compaction — check inbox, beat, rewrite
          the parachute) and deletes the marker. Silent no-op otherwise.

There is NO PreCompact hook anymore: no schema-legal channel reaches the
summarizer, so pre-compaction preservation rests entirely on the
parachute file being kept current while working.

The parachute convention: each agent keeps
dev/coordination/scratchboards/<tag>/inflight.md CURRENT while working
(in-flight items + next steps, an "## armed" section listing every
cron/wakeup with interval + prompt, and who they're waiting on). After
compaction the ritual has the agent rewrite it fresh, so it never goes
stale across cycles. The marker is keyed by the hook payload's
session_id, which both fires of the relay see even if the tag can't be
resolved (markers older than 48 h are swept).

Fail-soft like tayfa-beat: outside a tayfa project, or in an
unregistered session, emits nothing and exits 0 — a hook must never
break a session. Tag resolution: $TAYFA_TAG, else a strictly READ-ONLY
PID-ancestry match against .presence/*.json (hooks never write the
registry — the session_id self-heal was removed 2026-07-10; see
resolve_tag docstring).
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path


def find_coord_dir(start: Path) -> Path | None:
    cur = start.resolve()
    while True:
        candidate = cur / "dev" / "coordination" / "AGENTS.md"
        if candidate.is_file():
            return candidate.parent
        if cur.parent == cur:
            return None
        cur = cur.parent


def ancestor_pids(limit: int = 25) -> list[int]:
    chain: list[int] = []
    pid = os.getpid()
    for _ in range(limit):
        chain.append(pid)
        try:
            stat = Path(f"/proc/{pid}/stat").read_text()
        except OSError:
            break
        try:
            ppid = int(stat.rsplit(")", 1)[1].split()[1])
        except (IndexError, ValueError):
            break
        if ppid <= 1:
            break
        pid = ppid
    return chain


def read_hook_stdin() -> dict:
    """Hook invocations pipe a JSON payload (incl. session_id); CLI runs
    have a tty or empty stdin. Never block, never fail."""
    try:
        import select
        if sys.stdin.isatty():
            return {}
        # Only read if data is actually ready — an open-but-silent stdin
        # (e.g. an inherited pipe) would block a bare read() forever.
        if not select.select([sys.stdin], [], [], 0.25)[0]:
            return {}
        data = sys.stdin.read()
        return json.loads(data) if data.strip() else {}
    except Exception:
        return {}


def resolve_tag(presence_dir: Path, session_id: str = "") -> str | None:
    """$TAYFA_TAG, else a strictly READ-ONLY PID-ancestry match.

    An earlier version "self-healed" registry entries using the hook
    payload's session_id. REMOVED 2026-07-10: harnesses can run two
    FORKS of one session, and forks share the session_id — healing let
    both copies claim the same tag and fight over the entry, corrupting
    the one identity signal agents had. Hooks must NEVER write to the
    registry. If your pid changed, re-register (register_presence.sh
    replaces entries whose pid is dead). If registration is refused, a
    live session owns the tag: do NOT overwrite it, do NOT kill the
    other process — surface the duplicate to the human and stop.
    """
    env_tag = os.environ.get("TAYFA_TAG", "").lstrip("@").strip()
    if env_tag:
        return env_tag
    pid_to_tag: dict[int, str] = {}
    for path in presence_dir.glob("*.json"):
        try:
            entry = json.loads(path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            continue
        pid = entry.get("pid")
        if isinstance(pid, int):
            pid_to_tag[pid] = entry.get("tag") or path.stem
    sid_to_tag: dict[str, str] = {}
    for path in presence_dir.glob("*.json"):
        try:
            entry = json.loads(path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, OSError):
            continue
        sid = entry.get("session_id")
        if isinstance(sid, str) and sid:
            sid_to_tag[sid] = entry.get("tag") or path.stem
    for pid in ancestor_pids():
        if pid in pid_to_tag:
            return pid_to_tag[pid]
    # Read-only session_id fallback: host processes churn under some
    # harnesses (VSCode extension respawns claude between turns), so the
    # registered pid goes stale within minutes. The session id — supplied
    # by the agent at registration — is the stable anchor. NOTHING is
    # written back (forks share a session id; both may match, both may
    # beat — annoying, never identity-corrupting).
    if session_id and session_id in sid_to_tag:
        return sid_to_tag[session_id]
    return None


RITUAL_DIR_NAME = "ritual_pending"
MARKER_MAX_AGE_S = 48 * 3600


def _marker_path(coord: Path, session_id: str) -> Path | None:
    safe = "".join(c for c in session_id if c.isalnum() or c in "-_")[:80]
    if not safe:
        return None
    return coord / ".presence" / RITUAL_DIR_NAME / safe


def _sweep_stale(ritual_dir: Path) -> None:
    import time
    try:
        for p in ritual_dir.iterdir():
            if time.time() - p.stat().st_mtime > MARKER_MAX_AGE_S:
                p.unlink(missing_ok=True)
    except OSError:
        pass


def cmd_post(coord: Path, stdin: dict) -> None:
    """PostCompact: no stdout (schema forbids context injection here) —
    just drop the marker the next UserPromptSubmit will act on."""
    marker = _marker_path(coord, str(stdin.get("session_id") or ""))
    if marker is None:
        return
    marker.parent.mkdir(parents=True, exist_ok=True)
    tag = resolve_tag(coord / ".presence", str(stdin.get("session_id") or "")) or ""
    marker.write_text(tag + "\n")


def cmd_prompt(coord: Path, stdin: dict) -> None:
    """UserPromptSubmit: if this session has a pending ritual marker,
    inject the re-entry ritual (this event MAY return additionalContext)
    and clear the marker."""
    marker = _marker_path(coord, str(stdin.get("session_id") or ""))
    if marker is None or not marker.is_file():
        return
    tag = (marker.read_text().strip()
           or resolve_tag(coord / ".presence", str(stdin.get("session_id") or "")) or "")
    marker.unlink(missing_ok=True)
    _sweep_stale(marker.parent)
    if tag:
        board = f"dev/coordination/scratchboards/{tag}/inflight.md"
        who = f"tayfa agent @{tag}"
        inbox_cmds = f"`tayfa-inbox {tag}`"
    else:
        board = "dev/coordination/scratchboards/<your tag>/inflight.md"
        who = ("a tayfa agent (tag unresolved — your registration likely broke "
               "during compaction; identify yourself from your scratchboard and "
               "re-run register_presence.sh)")
        inbox_cmds = "`tayfa-inbox <tag>`"
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "UserPromptSubmit",
        "additionalContext": (
            f"Context compaction happened before this turn. You are {who}. "
            "Before continuing, run the re-entry ritual: "
            f"(1) Read {board} — your pre-compaction in-flight state; trust it "
            "over the compaction summary where they disagree. "
            "(2) Crons and scheduled wakeups DID NOT survive compaction: check "
            "CronList, then re-arm everything in the file's '## armed' section. "
            f"(3) Run {inbox_cmds} for anything that arrived meanwhile. "
            "(4) Update your heartbeat note: `tayfa-beat --note \"...\"`. "
            "(4b) If your scratchboard has a ROLE file, re-read "
            "dev/coordination/roles/<role>.md for each line in it: a role's "
            "standing rules are what a summary blurs. "
            "(5) Rewrite the inflight file fresh — keep only still-true items. "
            "Then continue where you left off.")}}))


def main() -> int:
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    stdin = read_hook_stdin()
    try:
        coord = find_coord_dir(Path.cwd())
        if coord is None:
            return 0
        if mode == "--post":
            cmd_post(coord, stdin)
        elif mode == "--prompt":
            cmd_prompt(coord, stdin)
        # --pre retired 2026-07-10: PreCompact output cannot legally carry
        # context; accept and ignore so stale hook configs stay harmless.
    except Exception:  # fail-soft: hooks must never break a session
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
